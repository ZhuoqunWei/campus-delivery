APP_JWT_SECRET=change-me-to-at-least-32-random-bytes-0123456789
APP_SEED_PASSWORD=password
APP_CAMPUS_NAME=Main Campus
APP_CAMPUS_LAT=37.8719
APP_CAMPUS_LNG=-122.2585
APP_OFFER_TTL=20s
SIM_COURIERS=10
SIM_ORDERS_PER_MINUTE=2
SIM_SPEED_MPS=9
